---
import { SITE_TITLE, sitePath } from '../consts';

const beaconToken = process.env.CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const collectAnalytics = import.meta.env.PROD && Astro.site?.hostname === 'www.leehun.com' && beaconToken;
---

<footer>
	<span>{SITE_TITLE}</span>
	<a href="https://github.com/artilla">GitHub</a>
	<a href={sitePath('/rss.xml')}>RSS</a>
	<slot />
</footer>

{collectAnalytics && (
	<script
		is:inline
		type="module"
		src="https://static.cloudflareinsights.com/beacon.min.js"
		data-cf-beacon={JSON.stringify({ token: beaconToken })}
	></script>
)}

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1rem;
		margin-top: auto;
		padding: 1.5rem 1rem;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.9rem;
	}
</style>
